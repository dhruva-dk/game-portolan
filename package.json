{
  "name": "portolan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node -e \"require('fs').existsSync('node_modules/.package-lock.json')||require('child_process').execSync('npm install',{stdio:'inherit'})\" && vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "ios": "node tests/ios.ts",
    "check:assets": "vite build --logLevel warn && node tests/check-assets.ts"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
