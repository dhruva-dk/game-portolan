{
  "name": "portolan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "play": "vite --open",
    "build": "tsc --noEmit && vite build",
    "ios": "npm run build && cap run ios",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "npm run check && node --test tests/*.test.ts",
    "capture": "node tools/capture.ts",
    "hero": "node tools/hero.ts",
    "budget": "node tools/budget.ts",
    "hitch": "node tools/hitch.ts",
    "steps": "node tools/steps.ts",
    "shot": "xcrun devicectl device capture screenshot --device 00008140-000268A80140801C --destination captures/phone.png"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/three": "0.187.0",
    "@webgpu/types": "0.1.74",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
