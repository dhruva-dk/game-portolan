{
  "name": "portolan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "ios": "npm run build && cap run ios",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && eslint src tests tools && prettier --log-level warn --check src tests tools capacitor.config.ts eslint.config.js",
    "test": "npm run check && node --test tests/*.test.ts",
    "format": "prettier --log-level warn --write src tests tools capacitor.config.ts eslint.config.js",
    "sim": "node tools/sim/cli.ts",
    "browser": "node tools/browser.ts",
    "sounds": "node tools/sounds.ts"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@types/three": "0.187.0",
    "@webgpu/types": "0.1.74",
    "eslint": "10.15.0",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8"
  }
}
